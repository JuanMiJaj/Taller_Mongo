# Copia este archivo como ".env" y rellena tu cadena de conexión:
#     cp .env.example .env      (Linux/Mac)
#     copy .env.example .env    (Windows)

# Cadena de conexión a MongoDB.
# LOCAL (si instalas MongoDB Community Server):
MONGODB_URI=mongodb://127.0.0.1:27017/AtuendoDBx

# ATLAS (nube) — reemplaza usuario, contraseña y cluster:
# MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/AtuendoDBx

PORT=3000
